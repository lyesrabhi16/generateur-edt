# Used by docker-compose.yml. Copy to .env
DBName=agemp
DBUser=admin
DBPass=admin

# Any long random string, e.g. `openssl rand -hex 32`
JWTSecret=change_me_to_a_long_random_string

# Only needed for the email feature
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URLs as seen from the browser (baked into the frontend at build time)
VITE_API_URL=http://localhost:3000
VITE_APP_URL=http://localhost:5000
