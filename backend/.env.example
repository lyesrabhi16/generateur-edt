// Do not modify.
// This is a template for creating your own .env file 
// Create a .env file where this file is and copy/paste these below
// You can modify your .env file as it would not be included in commits anymore

ServerPort = 3000

DBHost = localhost
DBPort = 5432
DBName = agemp_db_local
DBUser = admin
DBPass = admin

// Secret used to sign/verify login JWTs (Auth/PersonneAuth.js, Auth/cookieJwtAuth.js).
// Use any long random string, e.g. `openssl rand -hex 32`
JWTSecret = change_me_to_a_long_random_string

// Google OAuth2 credentials used to send timetable emails (email/sendEmail.js).
// Create them in Google Cloud Console > APIs & Services > Credentials.
// Only needed if you use the email feature.
GOOGLE_CLIENT_ID = your_google_client_id
GOOGLE_CLIENT_SECRET = your_google_client_secret